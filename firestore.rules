rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection and all nested subcollections (debtors, creditors, repayments)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /debtors/{debtorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /repayments/{repaymentId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /creditors/{creditorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /repayments/{repaymentId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /inventory/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /stock_transactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // App licenses and activations - authenticated users only can read/write
    match /app_customers/{customerKey} {
      allow read, write: if request.auth != null;
    }

    // Default fallback: block all unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

